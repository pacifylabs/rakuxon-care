# ─────────────────────────────────────────────────────────────
# Rakuxon Care — copy to .env.local and fill in.
# .env* is gitignored; never commit real values.
# ─────────────────────────────────────────────────────────────

# ── Database (Neon Postgres) ─────────────────────────────────
# POOLED connection — note the "-pooler" in the hostname. This is what the
# app uses at runtime; serverless bursts need PgBouncer in front.
# Neon Console → your project → Connection string → "Pooled connection".
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# DIRECT connection — the SAME URL without "-pooler". Migrations only.
# PgBouncer does not support the session-level statements DDL needs, so
# drizzle-kit uses this instead. Not read at runtime.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# ── Email (Resend) ───────────────────────────────────────────
# resend.com → API Keys. Sending permission is enough.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"

# The From address. Its DOMAIN must be verified in Resend (DNS records),
# or every send fails with "domain is not verified".
ENQUIRY_FROM_EMAIL="no-reply@rakuxoncare.co.uk"

# Where new enquiry notifications land. Can be any mailbox you read.
ENQUIRY_NOTIFY_EMAIL="info@rakuxoncare.co.uk"

# ── Site ─────────────────────────────────────────────────────
# Absolute origin, used for canonical URLs and links inside emails.
NEXT_PUBLIC_SITE_URL="https://rakuxoncare.co.uk"
